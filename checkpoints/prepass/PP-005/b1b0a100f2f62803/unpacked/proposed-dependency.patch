diff --git a/deps/Lua/Lua.cmake b/deps/Lua/Lua.cmake
new file mode 100644
--- /dev/null
+++ b/deps/Lua/Lua.cmake
@@ -0,0 +1,15 @@
+# PROPOSED: source-audited, not built against the release in this prepass.
+# Pin: upstream Lua 5.5.1 plus the two-line GC fix identified in PATCHES.md.
+orcaslicer_add_cmake_project(Lua
+    FORWARD_CONFIG
+    URL https://www.lua.org/ftp/lua-5.5.1.tar.gz
+    URL_HASH SHA256=1c4b4068d67061f2a2231ad2b5422e77acea1487ea9890f6320af614f4373dce
+    PATCH_COMMAND
+        ${CMAKE_COMMAND} -E copy "${CMAKE_CURRENT_LIST_DIR}/CMakeLists.txt" "<SOURCE_DIR>/CMakeLists.txt"
+        COMMAND ${CMAKE_COMMAND} -E copy "${CMAKE_CURRENT_LIST_DIR}/PlanePathLuaConfig.cmake.in" "<SOURCE_DIR>/PlanePathLuaConfig.cmake.in"
+        COMMAND ${CMAKE_COMMAND} -E copy "${CMAKE_CURRENT_LIST_DIR}/LICENSE.lua.txt" "<SOURCE_DIR>/LICENSE.lua.txt"
+        COMMAND ${GIT_EXECUTABLE} -C <SOURCE_DIR> apply
+            "${CMAKE_CURRENT_LIST_DIR}/gc-negative-growth.patch"
+    CMAKE_ARGS
+        -DPLANEPATH_LUA_REVISION=5.5.1-pp1
+)
diff --git a/deps/Lua/PATCHES.md b/deps/Lua/PATCHES.md
new file mode 100644
--- /dev/null
+++ b/deps/Lua/PATCHES.md
@@ -0,0 +1,25 @@
+# Proposed Lua dependency profile
+
+Base: Lua 5.5.1 official release archive, SHA-256 in Lua.cmake.
+Revision: `5.5.1-pp1` (local packaging/profile identifier, not an upstream version).
+
+`gc-negative-growth.patch` adapts only source-root paths from upstream commit
+`0b29f408433e92953cc72b1d3e06c7ac8139e439`, authored 2026-09-16.
+Primary: https://github.com/lua/lua/commit/0b29f408433e92953cc72b1d3e06c7ac8139e439
+Bug: https://www.lua.org/bugs.html#5.5.1-1
+It guards a negative allocation delta before applying a GC parameter and adds
+an assertion of the parameter-helper precondition. Upstream's regression is
+in `testes/gengc.lua`; retrieve and execute it with an instrumented full test
+interpreter during dependency acceptance, not inside the sandbox allowlist.
+The two production hunks were inspected against the published 5.5.1 source.
+Actual application/build against the tarball was NOT possible here.
+
+The public sandbox does not expose collector controls and stays in default
+incremental mode. This is defense in depth, not a claim that denying that API
+proves every path to the bug unreachable.
+
+C99, static, int64/double, private LUAI_MAXSTACK=32768/LUAI_MAXCCALLS=100,
+no standard-library registration objects, no OS/platform loader options.
+The `lauxlib.c` unit still contains file-related auxiliary APIs; their presence
+in a binary is NOT script authority. The host must never register/use them for
+untrusted source. All source loading is a validated bounded memory buffer.
diff --git a/deps/Lua/PlanePathLuaConfig.cmake.in b/deps/Lua/PlanePathLuaConfig.cmake.in
new file mode 100644
--- /dev/null
+++ b/deps/Lua/PlanePathLuaConfig.cmake.in
@@ -0,0 +1,15 @@
+@PACKAGE_INIT@
+set(PlanePathLua_REVISION "@PLANEPATH_LUA_REVISION@")
+include("${CMAKE_CURRENT_LIST_DIR}/PlanePathLuaTargets.cmake")
+get_target_property(_pp_configs PlanePathLua::Lua IMPORTED_CONFIGURATIONS)
+# Debug cannot fall back to /MD Release on Windows. A multi-config build can
+# consume a Release-only prefix for Release; selecting Debug then fails during generation rather than mapping to Release.
+set_property(TARGET PlanePathLua::Lua PROPERTY MAP_IMPORTED_CONFIG_DEBUG DEBUG)
+set_property(TARGET PlanePathLua::Lua PROPERTY MAP_IMPORTED_CONFIG_RELEASE RELEASE RELWITHDEBINFO MINSIZEREL)
+set_property(TARGET PlanePathLua::Lua PROPERTY MAP_IMPORTED_CONFIG_RELWITHDEBINFO RELWITHDEBINFO RELEASE MINSIZEREL)
+set_property(TARGET PlanePathLua::Lua PROPERTY MAP_IMPORTED_CONFIG_MINSIZEREL MINSIZEREL RELEASE RELWITHDEBINFO)
+if(MSVC AND CMAKE_BUILD_TYPE STREQUAL "Debug" AND NOT "DEBUG" IN_LIST _pp_configs)
+    message(FATAL_ERROR "PlanePathLua has no /MDd Debug archive; rebuild the Debug dependency tree")
+endif()
+unset(_pp_configs)
+check_required_components(PlanePathLua)
