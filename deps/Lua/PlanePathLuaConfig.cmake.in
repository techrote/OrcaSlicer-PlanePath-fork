@PACKAGE_INIT@
set(PlanePathLua_REVISION "@PLANEPATH_LUA_REVISION@")
include("${CMAKE_CURRENT_LIST_DIR}/PlanePathLuaTargets.cmake")

get_target_property(_pp_configs PlanePathLua::Lua IMPORTED_CONFIGURATIONS)
if(CMAKE_BUILD_TYPE STREQUAL "Debug" AND NOT "DEBUG" IN_LIST _pp_configs)
    message(FATAL_ERROR "PlanePathLua Debug archive is missing: rebuild the Debug dependency tree")
endif()

# Multi-config generators configure every configuration, even for Release
# builds. Provide a distinct expected Debug *path* when only Release was
# installed: the Release generator can succeed and attempting to link Debug
# fails (missing Debug archive), never silently linking a /MD Release library.
if(NOT "DEBUG" IN_LIST _pp_configs)
    if(WIN32)
        set(_pp_debug_archive "${PACKAGE_PREFIX_DIR}/lib/planepath_lua55d.lib")
    else()
        set(_pp_debug_archive "${PACKAGE_PREFIX_DIR}/lib/libplanepath_lua55d.a")
    endif()
    set_property(TARGET PlanePathLua::Lua APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
    set_property(TARGET PlanePathLua::Lua PROPERTY IMPORTED_LOCATION_DEBUG "${_pp_debug_archive}")
    set_property(TARGET PlanePathLua::Lua PROPERTY IMPORTED_LINK_INTERFACE_LANGUAGES_DEBUG "C")
    unset(_pp_debug_archive)
endif()

# Conversely, a Debug-only install must remain configureable with Visual
# Studio's all-configuration project generation. Its Release path is a distinct
# deliberately missing archive, never a fallback to /MDd Debug.
if(NOT "RELEASE" IN_LIST _pp_configs AND
   NOT "RELWITHDEBINFO" IN_LIST _pp_configs AND
   NOT "MINSIZEREL" IN_LIST _pp_configs)
    if(WIN32)
        set(_pp_release_archive "${PACKAGE_PREFIX_DIR}/lib/planepath_lua55.lib")
    else()
        set(_pp_release_archive "${PACKAGE_PREFIX_DIR}/lib/libplanepath_lua55.a")
    endif()
    set_property(TARGET PlanePathLua::Lua APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
    set_property(TARGET PlanePathLua::Lua PROPERTY IMPORTED_LOCATION_RELEASE "${_pp_release_archive}")
    set_property(TARGET PlanePathLua::Lua PROPERTY IMPORTED_LINK_INTERFACE_LANGUAGES_RELEASE "C")
    unset(_pp_release_archive)
endif()

set_property(TARGET PlanePathLua::Lua PROPERTY MAP_IMPORTED_CONFIG_DEBUG DEBUG)
set_property(TARGET PlanePathLua::Lua PROPERTY MAP_IMPORTED_CONFIG_RELEASE RELEASE RELWITHDEBINFO MINSIZEREL)
set_property(TARGET PlanePathLua::Lua PROPERTY MAP_IMPORTED_CONFIG_RELWITHDEBINFO RELWITHDEBINFO RELEASE MINSIZEREL)
set_property(TARGET PlanePathLua::Lua PROPERTY MAP_IMPORTED_CONFIG_MINSIZEREL MINSIZEREL RELEASE RELWITHDEBINFO)
unset(_pp_configs)
check_required_components(PlanePathLua)
